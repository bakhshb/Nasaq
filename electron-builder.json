{
  "appId": "com.nasaq.desktop",
  "productName": "Nasaq",
  "copyright": "Copyright © 2026 Nasaq",
  "directories": {
    "output": "release",
    "buildResources": "installer"
  },
  "files": [
    "dist-electron/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": ["dist-electron/preload.js", "**/node_modules/electron-updater/**"],
  "extraResources": [
    {
      "from": "dist",
      "to": "ui",
      "filter": ["**/*"]
    },
    {
      "from": "build/nasaq-engine/",
      "to": "nasaq-engine",
      "filter": ["nasaq-engine", "nasaq-engine.exe"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Nasaq-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Nasaq",
    "differentialPackage": true
  },
  "linux": {
    "target": ["dir"],
    "artifactName": "Nasaq-${version}-linux-${arch}.${ext}",
    "category": "Utility"
  },
  "publish": {
    "provider": "github",
    "owner": "bakhshb",
    "repo": "Nasaq",
    "releaseType": "release"
  }
}
